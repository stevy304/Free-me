# Free Me — Caddy Edge Reverse Proxy Configuration
{
  email admin@freeme.rw
  admin off
}

freeme.rw, www.freeme.rw {
  # Security Headers
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Content-Security-Policy "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; img-src 'self' https: data: blob:; media-src 'self' https: blob: data:;"
  }

  # Compress responses
  encode zstd gzip

  # API Gateway routes
  handle /api/* {
    reverse_proxy 10.0.1.10:4000 10.0.1.11:4000 {
      lb_policy round_robin
      health_uri /api/health
      health_interval 5s
      health_timeout 2s
    }
  }

  # Frontend SSR & Client routes
  handle {
    reverse_proxy 10.0.1.10:3000 10.0.1.11:3000 {
      lb_policy round_robin
      health_uri /
      health_interval 5s
    }
  }
}

# CDN Video Distribution Domain
cdn.freeme.rw {
  header {
    Access-Control-Allow-Origin "*"
    Cache-Control "public, max-age=31536000, immutable"
  }

  # Proxy to S3-compatible storage cluster
  reverse_proxy https://fsn1.your-objectstorage.com {
    header_up Host fsn1.your-objectstorage.com
  }
}
