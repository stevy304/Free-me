# /etc/freeme/freeme.env — read by every Free Me service on this server (owner root, mode 640, group freeme).
# The same file works on all application and media servers. See ENVIRONMENT.md for every variable.

APP_URL=https://freeme.example
SESSION_SECRET=
DATABASE_URL=postgresql://freeme:CHANGE_ME@10.0.1.20:5432/freeme
REDIS_URL=redis://:CHANGE_ME@10.0.1.20:6379
TRUST_PROXY=1
# Logs are JSON lines in production (LOG_FORMAT=text for readable lines)
#LOG_FORMAT=json
# One API process per CPU core (app servers)
API_PROCESSES=auto
# Monitoring (MONITORING.md): openssl rand -hex 24
#METRICS_TOKEN=
#WORKER_METRICS_PORT=9464
#WORKER_METRICS_HOST=10.0.1.30

# Sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_TRANSPORT=smtp
MAIL_FROM="Free Me <no-reply@freeme.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAILS=

# Who runs the service, shown on the Terms, Privacy Policy and Copyright pages and in notices (see ENVIRONMENT.md).
LEGAL_OPERATOR_NAME="Free Me"
LEGAL_CONTACT_EMAIL=
COPYRIGHT_EMAIL=
LEGAL_POSTAL_ADDRESS=
LEGAL_JURISDICTION=

# Video storage (S3-compatible, e.g. Hetzner Object Storage) and the CDN in front of its pub/ prefix
STORAGE_DRIVER=s3
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=freeme-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
MEDIA_PUBLIC_BASE_URL=https://media.freeme.example/pub
MAX_UPLOAD_MB=20480
UPLOAD_PART_MB=16

# Media worker (server 4)
WORKER_CONCURRENCY=2
TRANSCODE_PRESET=veryfast
# Automatic captions (optional, see DEPLOYMENT.md): whisper.cpp program and model
#WHISPER_CPP_PATH=/opt/whisper.cpp/build/bin/whisper-cli
#WHISPER_MODEL=/opt/whisper.cpp/models/ggml-small.bin

# Web app: where it reaches the API (same server)
API_INTERNAL_URL=http://127.0.0.1:4000
