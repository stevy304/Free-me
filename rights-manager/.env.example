# PostgreSQL (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://rights:rights@127.0.0.1:5432/rights
# Redis: Celery queue and results
REDIS_URL=redis://127.0.0.1:6379/0
# Signs sign-in tokens. Use a long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
# Where uploaded videos and thumbnails are stored (references/, checks/, thumbnails/)
UPLOAD_DIR=uploads

# Optional
# FRAME_DIR=/tmp/frames
# MAX_UPLOAD_MB=500
# CORS_ORIGINS=http://localhost:3000
# CELERY_EAGER=false          # true runs checks inside the API process (no worker; for trying it out only)
# SEED_PASSWORD=              # password for the seed accounts; random when empty
