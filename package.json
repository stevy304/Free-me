{
  "name": "free-me",
  "private": true,
  "version": "0.1.0",
  "description": "Free Me: a worldwide video-sharing and creator monetization platform.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --import tsx prisma/seed.ts",
    "dev:api": "npm run dev -w @free-me/api",
    "dev:web": "npm run dev -w @free-me/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "postinstall": "prisma generate && npm run build -w @free-me/shared"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
