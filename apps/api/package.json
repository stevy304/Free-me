{
  "name": "@free-me/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --copy-files",
    "start": "node dist/main.js",
    "dev": "swc src -d dist --strip-leading-paths -w & node --watch dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.21",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.1"
  },
  "dependencies": {
    "@free-me/shared": "0.1.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "google-auth-library": "10.9.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nodemailer": "7.0.13",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "@swc/jest"
      ]
    },
    "moduleNameMapper": {
      "^@free-me/shared$": "<rootDir>/../../packages/shared/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testTimeout": 30000
  }
}
