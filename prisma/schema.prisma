datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm: typo-tolerant search on titles and Space names (ships with PostgreSQL).
  extensions = [pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  VIEWER
  CREATOR
  ADVERTISER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OtpPurpose {
  SIGN_IN
}

enum MediaLocation {
  PUBLIC   // pub/ prefix: served by the CDN (public and unlisted videos)
  PRIVATE  // prv/ prefix: served only through short-lived signed links (private videos)
}

enum CollectionKind {
  SAVED   // the built-in "Saved" collection (one per account, private)
  CUSTOM
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  FLAGGED
  SUSPENDED
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum AdFormat {
  PRE_ROLL
  MID_ROLL
  BANNER_DISPLAY
  SPONSORED_CARD
}

enum PayoutStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PAID
  REJECTED
}

enum PayoutMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
  DIGITAL_WALLET
}

enum ModerationStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  WARNING_ISSUED
  VIDEO_TAKEDOWN
  VIDEO_RESTORED
  MONETIZATION_REVOKED
  ACCOUNT_SUSPENSION
  DISMISSED
}

// Sign-in is passwordless: Google (OAuthAccount) or a one-time code sent by email (EmailOtp).
model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  roles                 Role[]            @default([VIEWER])
  status                UserStatus        @default(ACTIVE)
  emailVerifiedAt       DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  oauthAccounts         OAuthAccount[]
  sessions              Session[]

  profile               Profile?
  channel               Channel?
  advertiser            Advertiser?
  subscriptions         Subscription[]
  videoLikes            Like[]
  comments              Comment[]
  playlists             Playlist[]
  watchHistories        WatchHistory[]
  interests             UserInterest[]
  reportsFiled          Report[]          @relation("UserReportsFiled")
  moderatorActions      ModerationAction[]
  auditLogs             AuditLog[]

  @@index([status])
}

model OAuthAccount {
  id                    String            @id @default(uuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String            // "google"
  providerAccountId     String            // the provider's stable subject id ("sub")
  email                 String
  createdAt             DateTime          @default(now())
  lastUsedAt            DateTime          @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// One-time sign-in codes. Only a keyed hash of the code is stored.
model EmailOtp {
  id                    String            @id @default(uuid())
  email                 String
  codeHash              String
  purpose               OtpPurpose        @default(SIGN_IN)
  attempts              Int               @default(0)
  expiresAt             DateTime
  consumedAt            DateTime?
  requestIp             String?
  createdAt             DateTime          @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

// Server-side sessions. The browser holds a random token; only its SHA-256 is stored.
model Session {
  id                    String            @id @default(uuid())
  tokenHash             String            @unique
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  method                String            // "google" | "email_otp"
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime          @default(now())
  lastSeenAt            DateTime          @default(now())
  expiresAt             DateTime
  revokedAt             DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Profile {
  id                    String            @id @default(uuid())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String
  avatarUrl             String?
  bio                   String?
  country               String?           // ISO 3166-1 alpha-2, chosen by the user
  city                  String?
  preferredLanguage     String            @default("en") // BCP 47
  timezone              String?           // IANA, e.g. "Africa/Kigali", "America/New_York"
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([country])
}

model Channel {
  id                    String            @id @default(uuid())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle                String            @unique
  name                  String
  description           String?
  avatarUrl             String?
  bannerUrl             String?
  country               String?           // ISO 3166-1 alpha-2
  defaultLanguage       String?           // BCP 47
  isVerified            Boolean           @default(false)
  subscriberCount       Int               @default(0)
  totalViews            BigInt            @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  videos                Video[]
  subscriptions         Subscription[]
  eligibility           CreatorEligibility?
  balance               CreatorBalance?
  payouts               Payout[]
  revenueRecords        RevenueLedger[]

  @@index([handle])
  @@index([isVerified])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Channel_name_trgm_idx")
}

model Video {
  id                    String            @id @default(uuid())
  channelId             String
  channel               Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  categoryId            String?
  category              Category?         @relation(fields: [categoryId], references: [id])
  language              String?           // BCP 47
  status                VideoStatus       @default(UPLOADING)
  visibility            Visibility        @default(PUBLIC)
  durationSeconds       Int               @default(0)
  width                 Int?              // display size after rotation
  height                Int?
  thumbnailKey          String?           // storage key of the chosen thumbnail
  thumbnailCandidates   String[]          // storage keys of generated frames the creator can choose from
  /// Seek-bar previews: { key, interval, count, cols, rows, width, height } of one sprite sheet under thumbs/.
  storyboard            Json?
  customThumbnail       Boolean           @default(false)
  isShort               Boolean           @default(false)
  madeForKids           Boolean           @default(false)
  processingProgress    Int               @default(0)   // 0-100
  processingStage       String?           // "Uploading", "SD ready", "HD processing", ...
  processingError       String?
  mediaLocation         MediaLocation     @default(PRIVATE)
  uploadId              String?           // multipart upload in progress
  sourceSizeBytes       BigInt?
  monetizationEnabled   Boolean           @default(false)
  viewCount             BigInt            @default(0)
  monetizedViewCount    BigInt            @default(0)
  watchTimeSeconds      BigInt            @default(0)
  likeCount             Int               @default(0)
  dislikeCount          Int               @default(0)   // never shown publicly; only to the creator
  commentCount          Int               @default(0)
  commentsEnabled       Boolean           @default(true)
  takenDownAt           DateTime?         // removed after a report or copyright notice; READY again if restored
  takedownReason        String?
  sourceFileS3Key       String?
  hlsMasterKey          String?           // HLS master playlist, relative to the video's media prefix
  publishedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  renditions            VideoRendition[]
  videoFiles            VideoFile[]
  tags                  VideoTag[]
  captions              Caption[]
  likes                 Like[]
  comments              Comment[]
  playlistItems         PlaylistItem[]
  watchHistories        WatchHistory[]
  adImpressions         AdImpression[]
  reports               Report[]

  @@index([channelId])
  @@index([categoryId])
  @@index([status, visibility])
  @@index([isShort])
  @@index([createdAt])
  @@index([channelId, createdAt])
  @@index([status, visibility, isShort, publishedAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Video_title_trgm_idx")
}

model VideoRendition {
  id                    String            @id @default(uuid())
  videoId               String
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  resolution            String            // "1080p", "720p", "480p", "360p"
  width                 Int
  height                Int
  bitrateKbps           Int
  playlistKey           String            // variant playlist, relative to the video's media prefix ("hls/720/index.m3u8")
  fileSizeBytes         BigInt
  codec                 String            @default("h264")
  codecs                String            @default("avc1.640028,mp4a.40.2") // RFC 6381, for the master playlist
  frameRate             Float             @default(30)
  createdAt             DateTime          @default(now())

  @@unique([videoId, resolution])
  @@index([videoId])
}

model VideoFile {
  id                    String            @id @default(uuid())
  videoId               String
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  s3Key                 String            @unique
  bucketName            String
  fileSize              BigInt
  mimeType              String
  checksumSha256        String?
  createdAt             DateTime          @default(now())

  @@index([videoId])
}

model Category {
  id                    String            @id @default(uuid())
  name                  String            @unique
  slug                  String            @unique
  description           String?
  videos                Video[]
  campaigns             CampaignCategory[]
  interestedUsers       UserInterest[]

  @@index([slug])
}

// Topics a person picked for their "For you" home. The home is built only from these, the creators they tune in
// to and recency: no watch-behaviour ranking.
model UserInterest {
  userId                String
  categoryId            String
  createdAt             DateTime          @default(now())
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}

model Tag {
  id                    String            @id @default(uuid())
  name                  String            @unique
  videos                VideoTag[]

  @@index([name])
}

model VideoTag {
  videoId               String
  tagId                 String
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag                   Tag               @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
  @@index([tagId])
}

model Subscription {
  id                    String            @id @default(uuid())
  userId                String
  channelId             String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel               Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt             DateTime          @default(now())

  @@unique([userId, channelId])
  @@index([channelId])
  @@index([userId])
}

model Like {
  id                    String            @id @default(uuid())
  userId                String
  videoId               String
  isLike                Boolean           @default(true) // true for like, false for dislike
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt             DateTime          @default(now())

  @@unique([userId, videoId])
  @@index([videoId])
}

model Comment {
  id                    String            @id @default(uuid())
  videoId               String
  userId                String
  parentId              String?           // For nested replies
  content               String
  likeCount             Int               @default(0)
  replyCount            Int               @default(0)
  isPinned              Boolean           @default(false)
  editedAt              DateTime?
  deletedAt             DateTime?         // removed by its author, the creator or a moderator; kept while it has replies
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent                Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies               Comment[]         @relation("CommentReplies")

  @@index([videoId])
  @@index([userId])
  @@index([videoId, parentId, createdAt])
  @@index([parentId, createdAt])
}

model Playlist {
  id                    String            @id @default(uuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind                  CollectionKind    @default(CUSTOM)
  title                 String
  description           String?
  visibility            Visibility        @default(PRIVATE)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  items                 PlaylistItem[]

  @@index([userId, kind])
}

model PlaylistItem {
  id                    String            @id @default(uuid())
  playlistId            String
  videoId               String
  position              Int               @default(0)
  addedAt               DateTime          @default(now())

  playlist              Playlist          @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@index([playlistId, position])
  @@index([videoId])
}

model WatchHistory {
  id                    String            @id @default(uuid())
  userId                String
  videoId               String
  progressSeconds       Int               @default(0)
  completed             Boolean           @default(false)
  lastWatchedAt         DateTime          @default(now())

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId, lastWatchedAt])
}

// -------------------------------------------------------------
// ADVERTISING & LOCAL BUSINESS SYSTEM
// -------------------------------------------------------------

model Advertiser {
  id                    String            @id @default(uuid())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName          String
  registrationNumber    String?           // business or tax registration number in its country
  country               String            // ISO 3166-1 alpha-2
  businessType          String
  contactPhone          String?
  isVerified            Boolean           @default(false)
  currency              String            // ISO 4217
  creditBalanceCents    BigInt            @default(0) // minor units of `currency`
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  campaigns             Campaign[]

  @@index([businessName])
}

model Campaign {
  id                    String            @id @default(uuid())
  advertiserId          String
  advertiser            Advertiser        @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  name                  String
  adFormat              AdFormat          @default(PRE_ROLL)
  status                CampaignStatus    @default(DRAFT)
  currency              String            // ISO 4217
  budgetAmountCents     BigInt            // minor units of `currency`
  spentAmountCents      BigInt            @default(0)
  targetCountries       String[]          // ISO 3166-1 alpha-2; empty = worldwide
  cpmRateCents          Int               // cost per 1,000 impressions, minor units
  adCreativeUrl         String            // Video or banner asset URL
  destinationUrl        String            // Advertiser landing page
  headline              String
  startDate             DateTime
  endDate               DateTime
  impressionsCount      BigInt            @default(0)
  clicksCount           BigInt            @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  targetCategories      CampaignCategory[]
  impressions           AdImpression[]

  @@index([advertiserId])
  @@index([status])
  @@index([targetCountries], type: Gin)
}

model CampaignCategory {
  campaignId            String
  categoryId            String
  campaign              Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category              Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([campaignId, categoryId])
}

model AdImpression {
  id                    String            @id @default(uuid())
  campaignId            String
  campaign              Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  videoId               String
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  viewerCountry         String?           // ISO 3166-1 alpha-2
  watchedDurationMs     Int
  completed             Boolean           @default(false)
  currency              String            // ISO 4217
  costChargedCents      Int
  creatorShareCents     Int               // creator pool share under the split in force
  platformShareCents    Int
  reinvestShareCents    Int
  createdAt             DateTime          @default(now())

  events                AdEvent[]

  @@index([campaignId])
  @@index([videoId])
  @@index([createdAt])
}

model AdEvent {
  id                    String            @id @default(uuid())
  impressionId          String
  impression            AdImpression      @relation(fields: [impressionId], references: [id], onDelete: Cascade)
  eventType             String            // "START", "FIRST_QUARTILE", "MIDPOINT", "COMPLETE", "CLICK", "SKIP"
  timestampMs           Int
  createdAt             DateTime          @default(now())

  @@index([impressionId])
}

// -------------------------------------------------------------
// CREATOR MONETIZATION & AUDITABLE FINANCIAL LEDGER
// -------------------------------------------------------------

model CreatorEligibility {
  id                    String            @id @default(uuid())
  channelId             String            @unique
  channel               Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  isEligible            Boolean           @default(false)
  appliedForMonetization Boolean          @default(false)
  subscribersRequired   Int               @default(1000)
  watchHoursRequired    Int               @default(4000)
  currentSubscribers    Int               @default(0)
  currentWatchHours     Float             @default(0.0)
  approvedAt            DateTime?
  rejectionReason       String?
  updatedAt             DateTime          @updatedAt
}

model CreatorBalance {
  id                    String            @id @default(uuid())
  channelId             String            @unique
  channel               Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  currency              String            // ISO 4217
  pendingBalanceCents   BigInt            @default(0)
  confirmedBalanceCents BigInt            @default(0)
  lifetimeEarningsCents BigInt            @default(0)
  withdrawnCents        BigInt            @default(0)
  updatedAt             DateTime          @updatedAt
}

model RevenueLedger {
  id                    String            @id @default(uuid())
  channelId             String
  channel               Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sourceType            String            // "AD_SHARE_PRE_ROLL", "AD_SHARE_BANNER", "PLATFORM_BONUS", "PAYOUT_DEDUCTION"
  referenceId           String?           // Reference to AdImpression or Payout
  currency              String            // ISO 4217
  grossAmountCents      BigInt
  creatorShareCents     BigInt            // under the split in force (splitBps)
  platformShareCents    BigInt
  reinvestShareCents    BigInt
  splitBps              String            // e.g. "6000/3000/1000", recorded with every entry
  balanceAfterCents     BigInt
  description           String
  isReconciled          Boolean           @default(false)
  createdAt             DateTime          @default(now())

  @@index([channelId])
  @@index([createdAt])
}

model Payout {
  id                    String            @id @default(uuid())
  channelId             String
  channel               Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  amountCents           BigInt
  currency              String            // ISO 4217
  method                PayoutMethod
  provider              String            // payout adapter, e.g. "mtn_momo", "mpesa", "bank", "paypal"
  accountIdentifier     String            // phone number, IBAN or account id at the provider
  accountHolderName     String
  status                PayoutStatus      @default(REQUESTED)
  referenceTransactionId String?
  requestedAt           DateTime          @default(now())
  processedAt           DateTime?
  rejectionReason       String?

  @@index([channelId])
  @@index([status])
}

// -------------------------------------------------------------
// MODERATION, COMPLIANCE & SECURITY AUDIT
// -------------------------------------------------------------

model Report {
  id                    String            @id @default(uuid())
  reporterId            String
  reporter              User              @relation("UserReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  videoId               String
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  reason                String            // see REPORT_REASONS in packages/shared
  details               String?
  timestampSeconds      Int?              // where in the video the problem is
  status                ModerationStatus  @default(PENDING)
  // Copyright notices only: who owns the work, what it is, and the signed statements.
  claimantName          String?
  claimantEmail         String?
  claimantAddress       String?
  originalWork          String?
  signature             String?
  // Counter-notice from the creator after a copyright removal.
  counterStatement      String?
  counterName           String?
  counterAddress        String?
  counterAt             DateTime?
  resolution            String?           // what the moderator decided, shown to the reporter and the creator
  resolvedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  moderationActions     ModerationAction[]

  @@index([videoId])
  @@index([status, createdAt])
  @@index([reporterId])
}

model ModerationAction {
  id                    String            @id @default(uuid())
  reportId              String?
  report                Report?           @relation(fields: [reportId], references: [id], onDelete: SetNull)
  moderatorId           String
  moderator             User              @relation(fields: [moderatorId], references: [id], onDelete: Cascade)
  videoId               String?           // the video acted on (also for actions without a report)
  action                ModerationActionType
  notes                 String?
  createdAt             DateTime          @default(now())

  @@index([moderatorId])
  @@index([videoId])
}

model AuditLog {
  id                    String            @id @default(uuid())
  userId                String?
  user                  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  action                String            // "USER_LOGIN", "CAMPAIGN_APPROVED", "PAYOUT_APPROVED", "REVENUE_SPLIT_CHANGE", "VIDEO_DELETED"
  entityType            String            // "User", "Campaign", "Payout", "Video", "SystemSetting"
  entityId              String?
  ipAddress             String?
  userAgent             String?
  detailsJson           String?           // Detailed payload diff
  createdAt             DateTime          @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum CaptionSource {
  UPLOADED
  AUTO
}

/// Subtitles for one video in one language (WebVTT stored under the video's media prefix: captions/<language>.vtt).
model Caption {
  id                    String            @id @default(uuid())
  videoId               String
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  language              String            // BCP 47, e.g. "en", "rw"
  source                CaptionSource
  key                   String            // relative to the video's media prefix
  cueCount              Int
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([videoId, language])
}
