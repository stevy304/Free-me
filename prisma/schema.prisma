datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm: typo-tolerant search on titles and Space names (ships with PostgreSQL).
  extensions = [pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  VIEWER
  CREATOR
  ADVERTISER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OtpPurpose {
  SIGN_IN
}

enum MediaLocation {
  PUBLIC   // pub/ prefix: served by the CDN (public and unlisted videos)
  PRIVATE  // prv/ prefix: served only through short-lived signed links (private videos)
}

enum CollectionKind {
  SAVED   // the built-in "Saved" collection (one per account, private)
  CUSTOM
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  FLAGGED
  SUSPENDED
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum AdFormat {
  PRE_ROLL
  MID_ROLL
  BANNER_DISPLAY
  SPONSORED_CARD
}

enum PayoutStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PAID
  REJECTED
}

enum PayoutMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
  DIGITAL_WALLET
}

enum ModerationStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  WARNING_ISSUED
  VIDEO_TAKEDOWN
  VIDEO_RESTORED
  MONETIZATION_REVOKED
  ACCOUNT_SUSPENSION
  DISMISSED
}

// Sign-in is passwordless: Google (OAuthAccount) or a one-time code sent by email (EmailOtp).
model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  roles                 Role[]            @default([VIEWER])
  status                UserStatus        @default(ACTIVE)
  emailVerifiedAt       DateTime?
  lastLoginAt           DateTime?
  /// Premium membership runs until this moment (null or past: not a member).
  premiumUntil          DateTime?
  /// Creator pass (uploading after the free videos, up to a yearly number) runs until this moment; Premium includes it.
  creatorPassUntil      DateTime?
  /// Plus (no ads, every quality) runs until this moment
  plusUntil             DateTime?
  /// Family & TV (Plus for the holder and up to 3 members) runs until this moment
  familyUntil           DateTime?
  /// Member of this account's Family & TV plan
  familyOwnerId         String?
  familyOwner           User?             @relation("FamilyMembers", fields: [familyOwnerId], references: [id], onDelete: SetNull)
  familyMembers         User[]            @relation("FamilyMembers")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  payments              Payment[]
  oauthAccounts         OAuthAccount[]
  sessions              Session[]

  profile               Profile?
  channel               Channel?
  advertiser            Advertiser?
  subscriptions         Subscription[]
  videoLikes            Like[]
  comments              Comment[]
  playlists             Playlist[]
  watchHistories        WatchHistory[]
  interests             UserInterest[]
  reportsFiled          Report[]          @relation("UserReportsFiled")
  notifications         Notification[]    @relation("NotificationsReceived")
  notificationsCaused   Notification[]    @relation("NotificationsCaused")
  pushSubscriptions     PushSubscription[]
  moderatorActions      ModerationAction[]
  auditLogs             AuditLog[]

  @@index([status])

  @@index([familyOwnerId])
}

model OAuthAccount {
  id                    String            @id @default(uuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String            // "google"
  providerAccountId     String            // the provider's stable subject id ("sub")
  email                 String
  createdAt             DateTime          @default(now())
  lastUsedAt            DateTime          @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// One-time sign-in codes. Only a keyed hash of the code is stored.
model EmailOtp {
  id                    String            @id @default(uuid())
  email                 String
  codeHash              String
  purpose               OtpPurpose        @default(SIGN_IN)
  attempts              Int               @default(0)
  expiresAt             DateTime
  consumedAt            DateTime?
  requestIp             String?
  createdAt             DateTime          @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

// Server-side sessions. The browser holds a random token; only its SHA-256 is stored.
model Session {
  id                    String            @id @default(uuid())
  tokenHash             String            @unique
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  method                String            // "google" | "email_otp"
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime          @default(now())
  lastSeenAt            DateTime          @default(now())
  expiresAt             DateTime
  revokedAt             DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Profile {
  id                    String            @id @default(uuid())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String
  avatarUrl             String?
  bio                   String?
  country               String?           // ISO 3166-1 alpha-2, chosen by the user
  city                  String?
  preferredLanguage     String            @default("en") // BCP 47
  timezone              String?           // IANA, e.g. "Africa/Kigali", "America/New_York"
  /// "For you" may use what this person watches and likes (on by default; off: only picked topics and followed Spaces)
  personalizedRecommendations Boolean     @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([country])
}

model Channel {
  id                    String            @id @default(uuid())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle                String            @unique
  name                  String
  description           String?
  avatarUrl             String?
  bannerUrl             String?
  country               String?           // ISO 3166-1 alpha-2
  defaultLanguage       String?           // BCP 47
  isVerified            Boolean           @default(false)
  /// Why the badge shows: "PREMIUM" (removed when membership ends) or "ADMIN" (kept).
  verificationSource    String?
  supportEnabled        Boolean           @default(false)
  supportPayments       Payment[]         @relation("SupportRecipient")
  /// Uploads ever started (deleting a video does not give a free upload back)
  uploadCount           Int               @default(0)
  businessVerification  BusinessVerification?
  subscriberCount       Int               @default(0)
  totalViews            BigInt            @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  videos                Video[]
  subscriptions         Subscription[]
  eligibility           CreatorEligibility?
  balance               CreatorBalance?
  liveStreams           LiveStream[]
  /// Secret for encoders (OBS, TV): whoever has it can broadcast on this Space. Stays the same between streams.
  liveStreamKey         String?           @unique
  payoutAccount         PayoutAccount?
  payouts               Payout[]
  revenueRecords        RevenueLedger[]

  @@index([handle])
  @@index([isVerified])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Channel_name_trgm_idx")
}

model Video {
  id                    String            @id @default(uuid())
  channelId             String
  channel               Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  categoryId            String?
  category              Category?         @relation(fields: [categoryId], references: [id])
  language              String?           // BCP 47
  status                VideoStatus       @default(UPLOADING)
  visibility            Visibility        @default(PUBLIC)
  durationSeconds       Int               @default(0)
  width                 Int?              // display size after rotation
  height                Int?
  thumbnailKey          String?           // storage key of the chosen thumbnail
  thumbnailCandidates   String[]          // storage keys of generated frames the creator can choose from
  /// Seek-bar previews: { key, interval, count, cols, rows, width, height } of one sprite sheet under thumbs/.
  storyboard            Json?
  /// Fingerprints of the uploaded file, for matching against blocked content (removed videos, imported lists).
  sourceSha256          String?
  sourceMd5             String?
  /// A moderator released this video after the automatic check held it; it is not checked again.
  screeningClearedAt    DateTime?
  customThumbnail       Boolean           @default(false)
  isShort               Boolean           @default(false)
  /// Made from a sound file (a podcast or music): the cover image with a waveform.
  isPodcast             Boolean           @default(false)
  /// An ad uploaded in Ad Studio: unlisted, never in feeds, search or the Space's videos.
  isAd                  Boolean           @default(false)
  madeForKids           Boolean           @default(false)
  processingProgress    Int               @default(0)   // 0-100
  processingStage       String?           // "Uploading", "SD ready", "HD processing", ...
  processingError       String?
  mediaLocation         MediaLocation     @default(PRIVATE)
  uploadPartBytes       BigInt?           // negotiated size for resumable uploads
  uploadId              String?           // multipart upload in progress
  sourceSizeBytes       BigInt?
  monetizationEnabled   Boolean           @default(false)
  viewCount             BigInt            @default(0)
  monetizedViewCount    BigInt            @default(0)
  watchTimeSeconds      BigInt            @default(0)
  likeCount             Int               @default(0)
  dislikeCount          Int               @default(0)   // never shown publicly; only to the creator
  commentCount          Int               @default(0)
  commentsEnabled       Boolean           @default(true)
  takenDownAt           DateTime?         // removed after a report or copyright notice; READY again if restored
  takedownReason        String?
  sourceFileS3Key       String?
  hlsMasterKey          String?           // HLS master playlist, relative to the video's media prefix
  /// Every quality (Premium viewers and the owner); null when it is the same as hlsMasterKey (no limit applied)
  hlsFullMasterKey      String?
  /// 1080p and above wait until the video is watched enough (HD_MIN_VIEWS); the worker then adds them
  /// Hidden until a moderator reviews it: reported by several established accounts (REPORT_HOLD_THRESHOLD)
  reviewHoldAt          DateTime?
  hdPending             Boolean           @default(false)
  /// When the AV1 renditions (popular videos, AV1_MIN_VIEWS) were queued; null = not yet. Set once, so it is queued once.
  av1QueuedAt           DateTime?
  /// Per-title encoding (media/per-title.ts): the CRF this video's content needs to look as good as CRF 21 (21–25);
  /// chosen once from samples, then used by every later pass (HD, AV1) so its qualities stay consistent.
  encodeCrf             Int?
  /// When the automatic safety check (safety/) passed. Nobody but the owner can see or find the video, and its files
  /// stay off the public CDN, until it is set. Uploads and live recordings start without it; rows made any other way
  /// (seeds, before this existed) count as checked.
  safetyCheckedAt       DateTime?         @default(now())
  /// The automatic decision (safety/ai.ts): publish, limit (watchable by its link only, kept out of feeds, search and
  /// recommendations until it proves itself) or reject (not published; the creator sees why and can appeal).
  safetyDecision        String?
  /// Why, in words the creator reads; and which model decided.
  safetyReason          String?
  safetyModel           String?
  /// Set while the video is limited (see safetyDecision); cleared when it is released.
  safetyLimitedAt       DateTime?
  /// When the creator asked for the decision to be looked at again (once per video).
  appealedAt            DateTime?
  publishedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  renditions            VideoRendition[]
  videoFiles            VideoFile[]
  tags                  VideoTag[]
  captions              Caption[]
  dailyStats            VideoDailyStat[]
  notifications         Notification[]
  /// When followers were told about this video (once, the first time it is public and ready).
  announcedAt           DateTime?
  likes                 Like[]
  comments              Comment[]
  playlistItems         PlaylistItem[]
  watchHistories        WatchHistory[]
  adImpressions         AdImpression[]
  reports               Report[]

  captionAttemptedAt    DateTime?

  @@index([status, captionAttemptedAt])
  @@index([hdPending, viewCount])
  @@index([av1QueuedAt, viewCount])
  @@index([channelId])
  @@index([categoryId])
  @@index([status, visibility])
  @@index([isShort])
  @@index([createdAt])
  @@index([channelId, createdAt])
  @@index([status, visibility, isShort, publishedAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Video_title_trgm_idx")
  @@index([sourceSha256])
  @@index([safetyLimitedAt])
}

model VideoRendition {
  id                    String            @id @default(uuid())
  videoId               String
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  resolution            String            // "1080p", "720p", "480p", "360p"
  width                 Int
  height                Int
  bitrateKbps           Int
  playlistKey           String            // variant playlist, relative to the video's media prefix ("hls/720/index.m3u8")
  fileSizeBytes         BigInt
  codec                 String            @default("h264") // "h264" or "av1" (the same resolution can exist in both)
  codecs                String            @default("avc1.640028,mp4a.40.2") // RFC 6381, for the master playlist
  frameRate             Float             @default(30)
  /// Measured from the encoded segments (video only): the busiest segment's bitrate and the average. The master
  /// playlist declares these, so players choose from what this video really needs, not from the rung's ceiling.
  peakKbps              Int?
  averageKbps           Int?
  createdAt             DateTime          @default(now())

  @@unique([videoId, resolution, codec])
  @@index([videoId])
}

model VideoFile {
  id                    String            @id @default(uuid())
  videoId               String
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  s3Key                 String            @unique
  bucketName            String
  fileSize              BigInt
  mimeType              String
  checksumSha256        String?
  createdAt             DateTime          @default(now())

  @@index([videoId])
}

model Category {
  id                    String            @id @default(uuid())
  name                  String            @unique
  slug                  String            @unique
  description           String?
  videos                Video[]
  campaigns             CampaignCategory[]
  interestedUsers       UserInterest[]

  @@index([slug])
}

// Topics a person picked for their "For you" home. The home is built only from these, the creators they tune in
// to and recency: no watch-behaviour ranking.
model UserInterest {
  userId                String
  categoryId            String
  createdAt             DateTime          @default(now())
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}

model Tag {
  id                    String            @id @default(uuid())
  name                  String            @unique
  videos                VideoTag[]

  @@index([name])
}

model VideoTag {
  videoId               String
  tagId                 String
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag                   Tag               @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
  @@index([tagId])
}

model Subscription {
  id                    String            @id @default(uuid())
  userId                String
  channelId             String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel               Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt             DateTime          @default(now())

  @@unique([userId, channelId])
  @@index([channelId])
  @@index([userId])
}

model Like {
  id                    String            @id @default(uuid())
  userId                String
  videoId               String
  isLike                Boolean           @default(true) // true for like, false for dislike
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt             DateTime          @default(now())

  @@unique([userId, videoId])
  @@index([videoId])
}

model Comment {
  id                    String            @id @default(uuid())
  videoId               String
  userId                String
  parentId              String?           // For nested replies
  content               String
  likeCount             Int               @default(0)
  replyCount            Int               @default(0)
  isPinned              Boolean           @default(false)
  editedAt              DateTime?
  deletedAt             DateTime?         // removed by its author, the creator or a moderator; kept while it has replies
  /// Checked by the AI moderator. Empty while a low-risk comment, already shown, waits for its check (engagement/comment-check.ts).
  checkedAt             DateTime?         @default(now())
  /// Why the automatic check removed it (kept for the record and for moderators).
  removedReason         String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent                Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies               Comment[]         @relation("CommentReplies")

  @@index([videoId])
  @@index([userId])
  @@index([videoId, parentId, createdAt])
  @@index([parentId, createdAt])
  @@index([checkedAt])
}

model Playlist {
  id                    String            @id @default(uuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind                  CollectionKind    @default(CUSTOM)
  title                 String
  description           String?
  visibility            Visibility        @default(PRIVATE)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  items                 PlaylistItem[]

  @@index([userId, kind])
}

model PlaylistItem {
  id                    String            @id @default(uuid())
  playlistId            String
  videoId               String
  position              Int               @default(0)
  addedAt               DateTime          @default(now())

  playlist              Playlist          @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@index([playlistId, position])
  @@index([videoId])
}

model WatchHistory {
  id                    String            @id @default(uuid())
  userId                String
  videoId               String
  progressSeconds       Int               @default(0)
  completed             Boolean           @default(false)
  lastWatchedAt         DateTime          @default(now())

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId, lastWatchedAt])
  @@index([videoId, lastWatchedAt])
}

// -------------------------------------------------------------
// ADVERTISING & LOCAL BUSINESS SYSTEM
// -------------------------------------------------------------

model Advertiser {
  id                    String            @id @default(uuid())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName          String
  registrationNumber    String?           // business or tax registration number in its country
  country               String            // ISO 3166-1 alpha-2
  businessType          String
  contactPhone          String?
  isVerified            Boolean           @default(false)
  currency              String            // ISO 4217
  creditBalanceCents    BigInt            @default(0) // minor units of `currency`
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  campaigns             Campaign[]

  @@index([businessName])
}

model Campaign {
  id                    String            @id @default(uuid())
  advertiserId          String
  advertiser            Advertiser        @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  name                  String
  adFormat              AdFormat          @default(PRE_ROLL)
  status                CampaignStatus    @default(DRAFT)
  currency              String            // ISO 4217
  budgetAmountCents     BigInt            // minor units of `currency`
  spentAmountCents      BigInt            @default(0)
  targetCountries       String[]          // ISO 3166-1 alpha-2; empty = worldwide
  targetVideoIds        String[]          @default([])
  targetChannelIds      String[]          @default([])
  cpmRateCents          Int               @default(0) // cost per 1,000 impressions, minor units (0: priced per day)
  adCreativeUrl         String?           // Video or banner asset URL
  /// The ad itself: one of the business's own videos (public or unlisted, ready).
  videoId               String?
  /// Days bought and the price of one day (minor units of `currency`).
  days                  Int               @default(0)
  dailyRateCents        Int               @default(0)
  reviewNote            String?
  reviewedAt            DateTime?
  destinationUrl        String            // Advertiser landing page
  headline              String
  startDate             DateTime
  endDate               DateTime
  /// A campaign priced per 1,000 views keeps running after endDate until it has delivered its budget, at most until here
  deliverUntil          DateTime?
  impressionsCount      BigInt            @default(0)
  clicksCount           BigInt            @default(0)
  payments              Payment[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  targetCategories      CampaignCategory[]
  impressions           AdImpression[]

  @@index([advertiserId])
  @@index([status])
  @@index([targetCountries], type: Gin)
}

model CampaignCategory {
  campaignId            String
  categoryId            String
  campaign              Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category              Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([campaignId, categoryId])
}

model AdImpression {
  id                    String            @id @default(uuid())
  campaignId            String
  campaign              Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  videoId               String
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  viewerCountry         String?           // ISO 3166-1 alpha-2
  watchedDurationMs     Int
  completed             Boolean           @default(false)
  currency              String            // ISO 4217
  costChargedCents      Int
  /// Where it played: before or halfway through a video (its creator's ad share), or between Moments (the Moments pool)
  placement             AdPlacement       @default(PRE_ROLL)
  creatorShareCents     Int               // creator pool share under the split in force
  platformShareCents    Int
  reinvestShareCents    Int
  createdAt             DateTime          @default(now())

  events                AdEvent[]

  @@index([campaignId])
  @@index([videoId])
  @@index([createdAt])
  @@index([placement, createdAt])
}

enum AdPlacement {
  PRE_ROLL
  MOMENTS
}

model AdEvent {
  id                    String            @id @default(uuid())
  impressionId          String
  impression            AdImpression      @relation(fields: [impressionId], references: [id], onDelete: Cascade)
  eventType             String            // "START", "FIRST_QUARTILE", "MIDPOINT", "COMPLETE", "CLICK", "SKIP"
  timestampMs           Int
  createdAt             DateTime          @default(now())

  @@index([impressionId])
}

// -------------------------------------------------------------
// CREATOR MONETIZATION & AUDITABLE FINANCIAL LEDGER
// -------------------------------------------------------------

model CreatorEligibility {
  id                    String            @id @default(uuid())
  channelId             String            @unique
  channel               Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  isEligible            Boolean           @default(false)
  appliedForMonetization Boolean          @default(false)
  subscribersRequired   Int               @default(1000)
  watchHoursRequired    Int               @default(4000)
  currentSubscribers    Int               @default(0)
  currentWatchHours     Float             @default(0.0)
  approvedAt            DateTime?
  rejectionReason       String?
  updatedAt             DateTime          @updatedAt
}

model CreatorBalance {
  id                    String            @id @default(uuid())
  channelId             String            @unique
  channel               Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  currency              String            // ISO 4217
  pendingBalanceCents   BigInt            @default(0)
  confirmedBalanceCents BigInt            @default(0)
  lifetimeEarningsCents BigInt            @default(0)
  withdrawnCents        BigInt            @default(0)
  updatedAt             DateTime          @updatedAt
}

model RevenueLedger {
  id                    String            @id @default(uuid())
  channelId             String
  channel               Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sourceType            String            // "AD_SHARE_PRE_ROLL", "AD_SHARE_BANNER", "PLATFORM_BONUS", "PAYOUT_DEDUCTION"
  referenceId           String?           // Reference to AdImpression or Payout
  currency              String            // ISO 4217
  grossAmountCents      BigInt
  creatorShareCents     BigInt            // under the split in force (splitBps)
  platformShareCents    BigInt
  reinvestShareCents    BigInt
  splitBps              String            // e.g. "6000/3000/1000", recorded with every entry
  balanceAfterCents     BigInt
  description           String
  isReconciled          Boolean           @default(false)
  createdAt             DateTime          @default(now())

  @@index([channelId])
  @@index([createdAt])
}

model PayoutAccount {
  id                    String   @id @default(uuid())
  channelId             String   @unique
  channel               Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  country               String
  provider              String
  accountIdentifier     String
  accountHolderName     String
  status                String   @default("PENDING")
  version               Int      @default(1)
  reviewNote            String?
  reviewedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status])
}

model Payout {
  idempotencyKey        String?           @unique
  destinationCurrency   String?
  destinationAmount     BigInt?
  feeAmount             BigInt?
  exchangeRate          Int?
  id                    String            @id @default(uuid())
  channelId             String
  channel               Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  amountCents           BigInt
  currency              String            // ISO 4217
  method                PayoutMethod
  provider              String            // payout adapter, e.g. "mtn_momo", "mpesa", "bank", "paypal"
  accountIdentifier     String            // phone number, IBAN or account id at the provider
  accountHolderName     String
  status                PayoutStatus      @default(REQUESTED)
  referenceTransactionId String?
  requestedAt           DateTime          @default(now())
  processedAt           DateTime?
  rejectionReason       String?

  @@index([channelId])
  @@index([status])
}

// -------------------------------------------------------------
// MODERATION, COMPLIANCE & SECURITY AUDIT
// -------------------------------------------------------------

model Report {
  id                    String            @id @default(uuid())
  reporterId            String?           // null: raised by the automatic upload check
  reporter              User?             @relation("UserReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  videoId               String
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  reason                String            // see REPORT_REASONS in packages/shared
  details               String?
  timestampSeconds      Int?              // where in the video the problem is
  status                ModerationStatus  @default(PENDING)
  // Copyright notices only: who owns the work, what it is, and the signed statements.
  claimantName          String?
  claimantEmail         String?
  claimantAddress       String?
  originalWork          String?
  signature             String?
  // Counter-notice from the creator after a copyright removal.
  counterStatement      String?
  counterName           String?
  counterAddress        String?
  counterAt             DateTime?
  resolution            String?           // what the moderator decided, shown to the reporter and the creator
  /// Higher first in the moderators' queue: 100 child safety, 80 graphic violence or sexual content, 60 hate,
  /// 40 other automatic findings, 0 reports from people (safety/policy.ts)
  priority              Int               @default(0)
  resolvedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  moderationActions     ModerationAction[]

  @@index([videoId])
  @@index([status, createdAt])
  @@index([reporterId])
  @@index([status, priority])
}

model ModerationAction {
  id                    String            @id @default(uuid())
  reportId              String?
  report                Report?           @relation(fields: [reportId], references: [id], onDelete: SetNull)
  moderatorId           String
  moderator             User              @relation(fields: [moderatorId], references: [id], onDelete: Cascade)
  videoId               String?           // the video acted on (also for actions without a report)
  action                ModerationActionType
  notes                 String?
  createdAt             DateTime          @default(now())

  @@index([moderatorId])
  @@index([videoId])
}

model AuditLog {
  id                    String            @id @default(uuid())
  userId                String?
  user                  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  action                String            // "USER_LOGIN", "CAMPAIGN_APPROVED", "PAYOUT_APPROVED", "REVENUE_SPLIT_CHANGE", "VIDEO_DELETED"
  entityType            String            // "User", "Campaign", "Payout", "Video", "SystemSetting"
  entityId              String?
  ipAddress             String?
  userAgent             String?
  detailsJson           String?           // Detailed payload diff
  createdAt             DateTime          @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum CaptionSource {
  UPLOADED
  AUTO
}

/// Subtitles for one video in one language (WebVTT stored under the video's media prefix: captions/<language>.vtt).
model Caption {
  id                    String            @id @default(uuid())
  videoId               String
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  language              String            // BCP 47, e.g. "en", "rw"
  source                CaptionSource
  key                   String            // relative to the video's media prefix
  cueCount              Int
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([videoId, language])
}

enum HashAlgorithm {
  SHA256
  MD5
}

enum BlockedHashSource {
  TAKEDOWN
  LIST
}

/// Content that must not come back: fingerprints of removed videos, and of known abusive material from imported lists.
/// An upload that matches is held for a moderator before anyone can see it.
model BlockedHash {
  id                    String            @id @default(uuid())
  algorithm             HashAlgorithm
  value                 String            // lowercase hex
  source                BlockedHashSource
  note                  String?           // list name, or why the video was removed
  videoId               String?           // the removed video it came from
  createdAt             DateTime          @default(now())

  @@unique([algorithm, value])
}

enum NotificationType {
  NEW_VIDEO
  COMMENT
  REPLY
  SPARK
  LIVE
}

/// A phone or computer that asked for notifications (Web Push). Removed when the push service says it is gone.
model PushSubscription {
  id                    String            @id @default(uuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint              String            @unique
  p256dh                String
  auth                  String
  userAgent             String?
  failures              Int               @default(0)
  createdAt             DateTime          @default(now())
  lastSentAt            DateTime?

  @@index([userId])
}

/// What appears under the bell. Sparks on one video are grouped into one unread entry (count, latest actor).
model Notification {
  id                    String            @id @default(uuid())
  userId                String
  user                  User              @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  type                  NotificationType
  actorId               String?
  actor                 User?             @relation("NotificationsCaused", fields: [actorId], references: [id], onDelete: SetNull)
  videoId               String?
  video                 Video?            @relation(fields: [videoId], references: [id], onDelete: Cascade)
  /// A live stream (type LIVE).
  liveStreamId          String?
  commentId             String?           // the comment or reply, to open it
  count                 Int               @default(1)
  readAt                DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, readAt])
}

/// Views and watch time of one video on one day (UTC), written by the view counter's batches. Creator Hub's charts read it.
/// Words and phrases the automatic text check looks for (safety/rules.ts), kept by moderators per language.
/// Built-in lists cover the basics; native speakers add what only they know (slang, coded words, local slurs).
model SafetyTerm {
  id                    String            @id @default(uuid())
  term                  String            // lower case; matched as a whole word or phrase after normalising
  language              String            // BCP 47 (rw, fr, en, sw …) or "any"
  category              String            // hate, harassment, sexual, violence, self-harm, illicit, spam
  /// 1: always hold or refuse; 0.6: hold only together with another finding
  weight                Float             @default(1)
  createdById           String?
  createdAt             DateTime          @default(now())

  @@unique([term, language, category])
}

/// What viewers experienced while playing, per hour (UTC) and per country, codec, device and connection
/// (media/qoe.ts): sessions, time to first frame (histogram), seconds played, rebuffering, quality shown, errors.
/// No account, video or address: only counts.
model QoeHourly {
  hour                  DateTime
  country               String            // ISO 3166-1 alpha-2, or ZZ when unknown
  codec                 String            // av1, h264, native (Safari's own player), other
  device                String            // phone, tablet, desktop, tv, other
  network               String            // slow-2g, 2g, 3g, 4g, unknown (the browser's estimate)
  sessions              Int               @default(0)
  /// Sessions that reached a first frame, by time to it: under 0.5, 1, 2, 3, 5, 8, 15 s and longer (8 buckets)
  startupBuckets        Int[]
  playedSeconds         BigInt            @default(0)
  stalls                Int               @default(0)
  stallMs               BigInt            @default(0)
  stalledSessions       Int               @default(0)
  /// Seconds played × the short side of the picture shown (average quality = this ÷ playedSeconds)
  qualitySeconds        BigInt            @default(0)
  errors                Int               @default(0)

  @@id([hour, country, codec, device, network])
  @@index([hour])
}

/// A batch of counted views and watch time already written (ViewCounter.flush): written in the same transaction as
/// the counts, so a batch retried after a crash is never added twice. Rows older than a week are deleted.
model CounterFlush {
  stamp                 String            @id
  createdAt             DateTime          @default(now())

  @@index([createdAt])
}

model VideoDailyStat {
  videoId               String
  video                 Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  day                   DateTime          @db.Date
  views                 Int               @default(0)
  watchSeconds          BigInt            @default(0)
  /// Watched by Plus, Family and Premium members: shares their subscription money with creators
  plusWatchSeconds      BigInt            @default(0)

  @@id([videoId, day])
  @@index([day])
}

// -------------------------------------------------------------
// PAYMENTS (Premium and ad campaigns)
// -------------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentPurpose {
  PREMIUM
  AD_CAMPAIGN
  CREATOR_SUPPORT
  CREATOR_PASS
  PLUS
  FAMILY
  VERIFICATION
}

model Payment {
  id                    String            @id @default(uuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose               PaymentPurpose
  /// "mtn_momo" or "flutterwave".
  provider              String
  /// The provider's reference (MoMo X-Reference-Id, Flutterwave tx_ref).
  providerRef           String            @unique
  /// What is charged, in minor units of `currency` (whole francs for RWF).
  amountMinor           BigInt
  currency              String
  /// The price in US cents, whatever currency was charged.
  usdCents              Int
  status                PaymentStatus     @default(PENDING)
  supportChannelId      String?
  supportChannel        Channel?          @relation("SupportRecipient", fields: [supportChannelId], references: [id], onDelete: Restrict)
  supportClearedAt      DateTime?
  requestKey            String?           @unique
  months                Int?
  campaignId            String?
  campaign              Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  phone                 String?
  /// Manual payments: the transaction id the payer sent from their MoMo / bank message.
  payerReference        String?
  checkoutUrl           String?
  failureReason         String?
  createdAt             DateTime          @default(now())
  paidAt                DateTime?
  receiptDueAt          DateTime?
  receiptSentAt         DateTime?

  @@index([supportChannelId, status])
  @@index([receiptDueAt])

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// One row per settled day of ad revenue (makes settlement safe to run twice).
model AdDaySettlement {
  day                   DateTime          @id @db.Date
  currency              String
  grossCents            BigInt
  creatorPoolCents      BigInt
  allocatedCents        BigInt
  platformCents         BigInt
  reinvestCents         BigInt
  impressions           Int
  channels              Int
  /// Plus and Family money of the day set aside for creators, and what was shared out (by members' watch time)
  subscriptionPoolCents BigInt            @default(0)
  subscriptionAllocatedCents BigInt       @default(0)
  /// Ads shown between Moments: their part of the day's ad money, the creators' 45%, and what was shared out (by Moments views)
  momentsGrossCents     BigInt            @default(0)
  momentsPoolCents      BigInt            @default(0)
  momentsAllocatedCents BigInt            @default(0)
  createdAt             DateTime          @default(now())
}

// -------------------------------------------------------------
// LIVE (Premium): from the browser, or from OBS / a TV encoder over RTMP
// -------------------------------------------------------------

enum LiveStatus {
  IDLE
  LIVE
  ENDED
  PREVIEW
}

model LiveStream {
  id                    String            @id @default(uuid())
  channelId             String
  channel               Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title                 String
  /// Shown under the stream, and copied to the replay
  description           String?
  /// PUBLIC: listed on Live and followers are told; UNLISTED: only people with the link
  visibility            Visibility        @default(PUBLIC)
  /// When it is planned to start (shown as Upcoming until then)
  scheduledFor          DateTime?
  /// Who can chat: everyone signed in, followers only, or nobody
  chatMode              String            @default("everyone")
  /// Seconds each viewer waits between messages (0: none; the host never waits)
  slowModeSeconds       Int               @default(0)
  /// Live captions from the host's browser may be shown to viewers
  captionsEnabled       Boolean           @default(true)
  /// Keep the recording as a video afterwards, and how visible that video is at first
  saveReplay            Boolean           @default(true)
  replayVisibility      Visibility        @default(PRIVATE)
  /// "normal" (about 10-15 s behind, steadiest on weak connections) or "low" (about 4-6 s, for talking with chat)
  latencyMode           String            @default("normal")
  /// Encoder rehearsal is private until the creator explicitly publishes it.
  finalizedAt           DateTime?
  encoderConnectedAt    DateTime?
  encoderHeartbeatAt    DateTime?
  /// First HLS media sequence allowed in public playback and the replay.
  encoderStartSequence  Int?
  ingestHealth          Json?
  status                LiveStatus        @default(IDLE)
  /// "browser" or "rtmp", while live.
  source                String?
  startedAt             DateTime?
  endedAt               DateTime?
  peakViewers           Int               @default(0)
  /// The recording, processed into an ordinary (private) video once the stream ends.
  replayVideoId         String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([status, startedAt])
  @@index([channelId, createdAt])
}

// Settings administrators change from the app (payment methods and prices). Secrets are encrypted.
model AppSetting {
  key                   String            @id
  value                 Json
  updatedBy             String?
  updatedAt             DateTime          @updatedAt
}

/// A business asks for the Verified badge (protects its name): an administrator checks the details, then the business
/// pays for a year. Status: PENDING (waiting for review), APPROVED (checked; pay to show the badge), ACTIVE (badge on
/// until verifiedUntil), REJECTED (with the reason).
model BusinessVerification {
  id                    String            @id @default(uuid())
  channelId             String            @unique
  channel               Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  businessName          String
  /// Company registration number (RDB in Rwanda) or tax number
  registrationNumber    String
  phone                 String
  website               String?
  status                String            @default("PENDING")
  reviewNote            String?
  reviewedAt            DateTime?
  verifiedUntil         DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([status])
}
