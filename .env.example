# Free Me configuration example. Copy to .env for local development; production values live in the
# deployment secret store (see ENVIRONMENT.md). Never commit real values.

# --- Shared ---
NODE_ENV=development
# PostgreSQL (docker compose -f docker-compose.dev.yml up -d starts one on localhost)
DATABASE_URL=postgresql://freeme:freeme@localhost:5432/freeme
# Redis: shared rate limits between API instances. Optional in development, required in production.
REDIS_URL=redis://localhost:6379

# --- API (apps/api) ---
PORT=4000
# Public address of the web app (origin only). Cookies, redirects and the CSRF check depend on it.
APP_URL=http://localhost:3000
# At least 32 random characters, e.g. `openssl rand -base64 48`. Required in production.
SESSION_SECRET=
SESSION_TTL_DAYS=30
# Google sign-in (OAuth client of type "Web application"). Authorised redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email for sign-in codes. Development: MAIL_TRANSPORT=console prints codes in the API log.
MAIL_TRANSPORT=console
MAIL_FROM="Free Me <no-reply@localhost>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Email addresses that become administrators when they sign in (comma-separated)
ADMIN_EMAILS=
# Proxies in front of the API (Caddy = 1) so client IPs are read from X-Forwarded-For
TRUST_PROXY=0
# OpenAPI docs at /api/docs (on by default outside production)
API_DOCS=true

# --- Web (apps/web) ---
# Where the web server reaches the API on the private network
API_INTERNAL_URL=http://localhost:4000
